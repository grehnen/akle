# Workers static assets headers: https://developers.cloudflare.com/workers/static-assets/headers/

# Vite puts a content hash in every file name under /assets/, so a changed file gets a new URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# index.html points at the current hashed assets, so browsers must revalidate it on every load.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# Previews (and the Worker's own workers.dev URL) must stay out of search results.
https://:preview.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
